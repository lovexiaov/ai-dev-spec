{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoggingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "level", "service", "env", "redactPaths"],
  "properties": {
    "format": { "type": "string", "enum": ["json", "pretty"] },
    "level": {
      "type": "string",
      "enum": ["trace", "debug", "info", "warn", "error", "critical"]
    },
    "service": { "type": "string" },
    "env": { "type": "string" },
    "redactPaths": { "type": "array", "items": { "type": "string" } },
    "sentry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dsn": { "type": "string" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sampleRate": { "type": "number" },
        "endpoint": { "type": "string" }
      }
    }
  }
}
