# 依赖
node_modules/

# 构建产物
dist/
build/
coverage/
*.tsbuildinfo

# 环境变量 / 凭据（见 AGENTS.md NEVER：密钥永不进仓）
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 系统
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# 本地 Agent 工作记忆（机器级状态，不随模板分发）
.workbuddy/*
# 例外：项目级 skill 是团队共享资产，必须入库；.workbuddy/memory/ 仍被忽略
!.workbuddy/skills/
!.workbuddy/skills/**

# 框架产物（AgentLog 导出的运行日志）
*.agent-log.jsonl

# Python bytecode
__pycache__/
*.pyc
