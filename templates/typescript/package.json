    "*.{ts,js,mjs}": ["eslint --fix", "prettier --write"]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "commitlint": "^19.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
