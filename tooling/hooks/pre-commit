#!/usr/bin/env sh
# 中立 pre-commit 模板（由 init.mjs / add-to-existing.mjs 复制到目标仓库的钩子目录）。
# 对应 AGENTS.md NEVER「提交密钥/.env」与「禁止 console.log 做生产日志」。
set -e

echo "🔍 扫描密钥文件 ..."
staged=$(git diff --cached --name-only --diff-filter=ACM)
printf '%s\n' "$staged" | grep -E '(^|/)\.env$|secrets?\.json$|id_rsa|\.pem$' | grep -v '\.env\.example$' && {
  echo "❌ 拒绝提交疑似密钥/凭据文件（.env / secrets.json / id_rsa / .pem）。请改用环境变量或密钥管理。"
  exit 1
}

echo "🧹 运行 lint 门禁（gate-runner）..."
node tooling/gate-runner.mjs --stages lint
